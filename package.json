{
  "name": "percentage-calculator-tool-desktop",
  "version": "1.0.0",
  "description": "Offline desktop percentage calculator built with Electron.",
  "main": "electron/main.cjs",
  "private": true,
  "author": "Directed by a Human, made by DeepSeek & ChatGPT",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-test.cjs",
    "build": "npm run test && npm run test:smoke && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "vitest": "^4.1.7"
  },
  "build": {
    "appId": "com.percentagecalculator.tool",
    "productName": "Percentage Calculator Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/icon.ico",
      "package.json",
      "!scripts/**/*",
      "!tests/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Percentage Calculator Tool"
    },
    "portable": {
      "artifactName": "Percentage Calculator Tool Portable ${version}.${ext}"
    }
  }
}
